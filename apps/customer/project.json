{
  "name": "customer",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/customer/src",
  "projectType": "application",
  "tags": [],
  "// targets": "to see all targets run: nx show project customer --web",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec oxlint -c .oxlintrc.json apps/customer --deny-warnings"
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prettier --write apps/customer"
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec prettier --check apps/customer"
      }
    }
  }
}
